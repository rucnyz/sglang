# Untracked cycle data — kept on disk, not in git.
# Each cycle is ~ 1 GB (sglang.log + harbor jobs + daemon.log + mooncake).

# Ignore everything under any cycles/ dir at any depth, keep only .gitkeep.
**/cycles/*
!**/cycles/.gitkeep

# experiments_notes/ instrument_chain evidence dirs
experiments_notes/instrument_chain/*
!experiments_notes/instrument_chain/.gitkeep

# Legacy data (~ 23 GB) — see _legacy/README.md
_legacy/*
!_legacy/README.md
